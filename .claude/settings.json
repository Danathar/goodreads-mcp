{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read",
      "Bash(pytest *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Edit(./.github/workflows/**)",
      "Write(./.github/workflows/**)"
    ],
    "deny": [
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.py\"",
            "timeout": 10,
            "statusMessage": "Checking the command against the allow-list guard"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f || exit 0; case \"$f\" in *goodreads_mcp/*.py) ;; *) exit 0;; esac; cd \"${CLAUDE_PROJECT_DIR:-.}\" || exit 0; command -v pytest >/dev/null 2>&1 || exit 0; if ! out=$(pytest -q 2>&1); then printf '%s' \"$out\" | tail -20 | jq -Rs '{hookSpecificOutput:{hookEventName:\"PostToolUse\",additionalContext:(\"Offline tests failed after this edit:\\n\" + .)}}'; fi; }",
            "timeout": 60,
            "statusMessage": "Running offline tests"
          }
        ]
      }
    ]
  }
}
