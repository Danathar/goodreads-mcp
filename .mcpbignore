.git
.gitignore
.pytest_cache
__pycache__
*.pyc
*.pyo
.venv
.venv310
.venv*/
venv
.DS_Store
*.mcpb
tests/
.github
# Repository-facing files the server never reads (#362): agent configuration,
# docs, prompts and contributor guidance. The bundle keeps manifest.json,
# pyproject.toml, goodreads_mcp/, README.md and the licences (hatchling reads
# README.md and both LICENSE files when `uv run` builds the project).
.claude/
.cursor/
docs/
prompts/
AGENTS.md
CLAUDE.md
CONTRIBUTING.md
.coverage-thresholds.json
.editorconfig
.gitignore
.mcpbignore
# The MCP registry listing (#180); the bundle is installed from the release
# page, not the registry, so it has no use for the file.
server.json
# `uv run` resolves dependencies from pyproject.toml on the user's machine;
# nothing pre-resolved ships in the bundle (#89).
vendor/
uv.lock
# `mcpb pack` reads the working tree, not git, so a file git refuses to track
# still ships unless it is named here too. `.coverage` is a SQLite database of
# absolute paths from the machine that measured it, which is the disclosure
# docs/SECURITY-AI.md records as having happened once already; the command in
# .coverage-thresholds.json writes one at the repository root.
.coverage
.coverage.*
# Dropped by mcpb's own defaults today. Named here so the bundle does not
# depend on that default staying put.
.env
.env.*
